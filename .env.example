# Ollama server reachable over Tailscale.
# OLLAMA_HOST is the Tailscale MagicDNS name (e.g. board-llm.tailXXXX.ts.net)
# or the 100.x Tailscale IP of the machine running Ollama.
# Copy this file to .env and fill in the real host. .env is gitignored.
OLLAMA_HOST=board-llm.tailXXXX.ts.net
OLLAMA_PORT=11434
